{
    "openapi": "3.1.0",
    "info": {
        "title": "BEAR.AppKata API",
        "description": "BEAR.Sunday reference application API",
        "version": "1.0.0"
    },
    "paths": {
        "/index": {
            "get": {
                "parameters": [
                    {
                        "name": "name",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response"
                    }
                }
            }
        },
        "/admin/index": {
            "get": {
                "operationId": "goAdminIndex",
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AdminIndex"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/admin/profile": {
            "get": {
                "operationId": "goAdminProfile",
                "parameters": [
                    {
                        "name": "id",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AdminProfile"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/cache/admin-dashboard": {
            "get": {
                "operationId": "goCacheAdminDashboard",
                "summary": "Cache showcase parent: `#[CacheableResponse]` tracks the embedded child.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CacheAdminDashboard"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/cache/admin-summary": {
            "get": {
                "operationId": "goCacheAdminSummary",
                "summary": "Cache showcase leaf: `#[Cacheable]` is the whole cache surface.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CacheAdminSummary"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "operationId": "doUpdateCacheAdminSummary",
                "summary": "Cache showcase leaf: `#[Cacheable]` is the whole cache surface.",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": "integer"
                                    },
                                    "displayName": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "id",
                                    "displayName"
                                ]
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/WriteResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    }
                }
            }
        },
        "/user/index": {
            "get": {
                "responses": {
                    "200": {
                        "description": "Successful response"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "AdminIndex": {
                "title": "AdminIndex",
                "type": "object",
                "required": [
                    "HELLO",
                    "defaultAdminId"
                ],
                "properties": {
                    "HELLO": {
                        "type": "string"
                    },
                    "defaultAdminId": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "additionalProperties": false
            },
            "AdminProfile": {
                "title": "AdminProfile",
                "type": "object",
                "required": [
                    "id",
                    "username",
                    "displayName",
                    "active",
                    "primaryEmail",
                    "verifiedEmailCount",
                    "emails",
                    "permissions",
                    "allowedResources",
                    "allowedPermissions"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "username": {
                        "type": "string"
                    },
                    "displayName": {
                        "type": "string"
                    },
                    "active": {
                        "type": "boolean"
                    },
                    "primaryEmail": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "verifiedEmailCount": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "emails": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "id",
                                "emailAddress",
                                "verified"
                            ],
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "minimum": 1
                                },
                                "emailAddress": {
                                    "type": "string"
                                },
                                "verified": {
                                    "type": "boolean"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "permissions": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "id",
                                "access",
                                "resourceName",
                                "permissionName"
                            ],
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "minimum": 1
                                },
                                "access": {
                                    "type": "string",
                                    "enum": [
                                        "allow",
                                        "deny"
                                    ]
                                },
                                "resourceName": {
                                    "type": "string"
                                },
                                "permissionName": {
                                    "type": "string"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "allowedResources": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "allowedPermissions": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "additionalProperties": false
            },
            "CacheAdminDashboard": {
                "title": "CacheAdminDashboard",
                "type": "object",
                "required": [
                    "summary",
                    "id",
                    "dependencyUri",
                    "cachePattern"
                ],
                "properties": {
                    "summary": {
                        "type": "object"
                    },
                    "id": {
                        "type": "integer"
                    },
                    "dependencyUri": {
                        "type": "string"
                    },
                    "cachePattern": {
                        "type": "string"
                    }
                },
                "additionalProperties": false
            },
            "CacheAdminSummary": {
                "title": "CacheAdminSummary",
                "type": "object",
                "required": [
                    "id",
                    "displayName",
                    "revision"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "displayName": {
                        "type": "string"
                    },
                    "revision": {
                        "type": "integer"
                    }
                },
                "additionalProperties": false
            },
            "WriteResponse": {
                "title": "WriteResponse",
                "description": "Permissive write response shape. Cacheable writes may refresh the same resource and return its read body after invalidation.",
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "message": {
                        "type": "string"
                    },
                    "displayName": {
                        "type": "string"
                    },
                    "revision": {
                        "type": "integer"
                    }
                }
            }
        }
    }
}