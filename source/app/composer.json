{
    "name": "my-vendor/my-project",
    "type": "project",
    "license": "proprietary",
    "description": "",
    "require": {
        "php": "^8.5.0",
        "aura/auth": "^4.0",
        "bear/async": "^0.3",
        "bear/aura-router-module": "^2.4",
        "bear/dotenv": "^1.0",
        "bear/package": "^1.14",
        "bear/resource": "^1.32",
        "bear/sunday": "^1.6",
        "guzzlehttp/guzzle": "^7.10",
        "koriym/env-json": "^1.0",
        "koriym/file-upload": "^1.0",
        "phpmailer/phpmailer": "^6.10",
        "qiq/qiq": "^3.0",
        "ray/aop": "^2.12",
        "ray/aura-session-module": "^1.2",
        "ray/di": "^2.14",
        "ray/identity-value-module": "^1.0",
        "ray/media-query": "^1.1",
        "ray/web-form-module": "^0.6.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.4",
        "bear/api-doc": "^1.9",
        "bear/devtools": "^1.0",
        "koriym/sql-quality": "^0.1.7",
        "phpunit/phpunit": "^10.0",
        "ray/fake-query": "dev-codex/fake-query-release-hardening as 1.0.x-dev",
        "rector/rector": "^2.2",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "MyVendor\\MyProject\\": "src/",
            "AppCore\\": [
                "ddd/core/src/",
                "ddd/core-deprecated/src/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyVendor\\MyProject\\": "tests/",
            "AppCore\\": [
                "ddd/core/tests/",
                "ddd/core-deprecated/tests/"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@setup",
            "@composer bin all install --ansi"
        ],
        "setup": "php bin/setup.php",
        "compile": [
            "cp -ap autoload.php autoload.php.org",
            "./vendor/bin/bear.compile 'MyVendor\\MyProject' prod-hal-api-app ./",
            "rm -rf autoload.php preload.php",
            "cp -ap autoload.php.org autoload.php",
            "./vendor/bin/bear.compile 'MyVendor\\MyProject' prod-html-app ./",
            "rm -rf autoload.php preload.php",
            "cp -ap autoload.php.org autoload.php",
            "./vendor/bin/bear.compile 'MyVendor\\MyProject' prod-cli-command-app ./",
            "rm -rf autoload.php preload.php",
            "mv autoload.php.org autoload.php"
        ],
        "doc": "./vendor/bin/apidoc",
        "test": "./vendor/bin/phpunit",
        "coverage": "php -dzend_extension=xdebug.so -dxdebug.mode=coverage ./vendor/bin/phpunit --coverage-text --coverage-html=build/coverage",
        "pcov": "php -dextension=pcov.so -d pcov.enabled=1 ./vendor/bin/phpunit --coverage-text --coverage-html=build/coverage  --coverage-clover=coverage.xml",
        "cs": "./vendor/bin/phpcs",
        "cs-fix": "./vendor/bin/phpcbf src tests",
        "metrics": "./vendor/bin/phpmetrics --report-html=build/metrics --exclude=Exception src",
        "clean": [
            "./vendor/bin/phpstan clear-result-cache",
            "./vendor/bin/psalm --clear-cache",
            "rm -rf ./var/tmp/*.php"
        ],
        "sa": [
            "./vendor/bin/psalm --show-info=true",
            "./vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G",
            "./vendor/bin/phpmd src text ./phpmd.xml",
            "./vendor/bin/phpmd ddd/core/src text ./phpmd.xml"
        ],
        "tests": [
            "@cs",
            "@sa",
            "@test"
        ],
        "build": [
            "@clean",
            "@cs",
            "@sa",
            "@pcov",
            "@compile",
            "@metrics"
        ],
        "serve": "COMPOSER_PROCESS_TIMEOUT=0 php -dzend_extension=xdebug.so -S 127.0.0.1:8080 -t public",
        "app": "php bin/app.php",
        "async": "php bin/async.php",
        "page": "php bin/page.php"
    },
    "scripts-descriptions": {
        "setup": "Setup the project",
        "compile": "Compile scripts for the production",
        "doc": "Generate API document",
        "test": "Run unit tests",
        "tests": "Run tests and quality checks",
        "coverage": "Generate test coverage report",
        "pcov": "Generate test coverage report (pcov)",
        "cs": "Checks the coding standard",
        "cs-fix": "Fix the coding standard",
        "sa": "Run static analysis",
        "metrics": "Build metrics report",
        "clean": "Clear cache files",
        "serve": "Start built-in server",
        "app": "Request app resource",
        "async": "Request app resource via the BEAR.Async linker; requires ext-parallel + ZTS PHP or a supported async runtime",
        "page": "Request page resource"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "aura/installer-default": true,
            "bamarni/composer-bin-plugin": true
        },
        "process-timeout" : 0
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false
        }
    },
    "repositories": [{
        "name": "ray-fake-query",
        "type": "vcs",
        "url": "https://github.com/ray-di/Ray.FakeQuery.git"
    }]
}
